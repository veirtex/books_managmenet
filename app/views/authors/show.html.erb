<% content_for :title, @author.name %>
<%= link_to "Back to authors", authors_path, class: "back-link" %>
<h1><%= @author.name %></h1>
<% if @author == current_author %>
  <%= link_to "Edit profile", edit_author_registration_path %>
<% end %>
<h2>Books</h2>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th scope="col">Title</th>
        <th scope="col">Published date</th>
      </tr>
    </thead>
    <tbody>
      <% @author.books.each do |book| %>
        <tr>
          <td><%= book.title %></td>
          <td><%= book.published_at %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @author.books.empty? %>
    <p class="empty-state">This author has no books yet.</p>
  <% end %>
</div>
