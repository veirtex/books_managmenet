<% content_for :title, "Books" %>
<h1>Books</h1>
<p><%= link_to "Download CSV", books_path(format: :csv, filterrific: @filterrific.to_hash), data: { turbo: false } %></p>

<%= form_with url: books_path, method: :get, scope: :filterrific, class: "filters" do |form| %>
  <div class="field">
    <%= form.label :with_name, "Book name" %>
    <%= form.search_field :with_name, value: @filterrific.with_name %>
  </div>
  <div class="field">
    <%= form.label :released_on, "Release date" %>
    <%= form.date_field :released_on, value: @filterrific.released_on %>
  </div>
  <div class="field">
    <%= form.label :with_author_name, "Author name" %>
    <%= form.search_field :with_author_name, value: @filterrific.with_author_name %>
  </div>
  <div class="form-actions">
    <%= form.submit "Filter" %>
    <%= link_to "Reset", books_path %>
  </div>
<% end %>

<div class="table-wrap">
  <table>
    <thead>
      <tr>
        <th scope="col">Title</th>
        <th scope="col">Published date</th>
        <th scope="col">Author</th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @books.each do |book| %>
        <tr>
          <td><%= book.title %></td>
          <td><%= book.published_at %></td>
          <td><%= link_to book.author.name, author_path(book.author) %></td>
          <td>
            <%= link_to "View", book_path(book) %>
            <% if book.author == current_author %>
              <%= link_to "Edit", edit_book_path(book) %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <% if @books.empty? %>
    <p class="empty-state">No books found.</p>
  <% end %>
</div>
